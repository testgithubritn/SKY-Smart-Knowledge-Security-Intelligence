{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sky: Run Dev Server",
      "detail": "Start the Next.js dev server on port 3000",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Next.js",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "revealProblems": "onProblem",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Sky: Lint (ESLint)",
      "detail": "Run ESLint on the entire project",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": true
      },
      "problemMatcher": ["$eslint-stylish"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": "build"
    },
    {
      "label": "Sky: Restart Dev Server",
      "detail": "Kill any running Next.js process and restart",
      "type": "shell",
      "command": "pkill -9 -f next || true; sleep 2; npm run dev",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Sky: Open in Browser",
      "detail": "Open the Sky app in the default browser",
      "type": "shell",
      "command": "open",
      "args": ["http://localhost:3000"],
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
